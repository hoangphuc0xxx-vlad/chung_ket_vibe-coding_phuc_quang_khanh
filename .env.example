# Sao chép file này thành .env rồi điền khóa. KHÔNG commit file .env.
# Không có khóa nào thì app vẫn chạy: mục "Gợi ý ưu đãi" dùng quy tắc trên máy.
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Tùy chọn: đồng bộ dữ liệu giữa các thiết bị qua Supabase (xem README). Để trống thì chỉ lưu localStorage.
# Dùng khóa secret / service_role. Khóa này CHỈ để ở máy chủ, không bao giờ đặt trong biến VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Tùy chọn: đổi mô hình
# GEMINI_MODEL=gemini-flash-lite-latest
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
